{
  "name": "Laravel — Sesion 7: BD y Eloquent",
  "image": "mcr.microsoft.com/devcontainers/php:8.2-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "onecentlin.laravel-blade",
        "shufo.vscode-blade-formatter"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteEnv": {
    "XDEBUG_MODE": "off"
  },
  "mounts": [
    "source=sesion7-vendor,target=${containerWorkspaceFolder}/vendor,type=volume"
  ],
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "Laravel",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "sudo php artisan serve --host=0.0.0.0 --port=80 > /dev/null 2>&1 &"
}
